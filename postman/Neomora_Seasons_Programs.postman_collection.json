    },
    {
      "name": "6 — Program Rules (Cohorts)",
      "description": "Eligibility rules define age groups (cohorts) within a programme. Each rule has:\n- **`label`** — human-readable cohort name shown in the UI and invoices (e.g. 'U8', 'U10', 'Junior Squad')\n- **`minBirthYear` / `maxBirthYear`** — inclusive birth year eligibility range\n- **`sessionsPerWeek`** — how many times this group trains per week\n- **`capacity`** — max enrolments for this cohort\n\n**Overlap guard:** Adding a rule whose birth year range overlaps any existing active rule is rejected with HTTP 409.",
      "item": [
        {
          "name": "Add Rule — U8 (born 2017–2020)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.id) {",
                  "    pm.collectionVariables.set('ruleId', res.id);",
                  "    pm.test('Rule created — ruleId saved', () => pm.response.to.have.status(201));",
                  "} else {",
                  "    pm.test('Add Rule failed', () => { throw new Error(JSON.stringify(res)); });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"U8\",\n  \"ruleType\": \"BIRTH_YEAR_RANGE\",\n  \"minBirthYear\": 2017,\n  \"maxBirthYear\": 2020,\n  \"sessionsPerWeek\": 2,\n  \"capacity\": 20\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/programs/{{programId}}/rules",
              "host": ["{{baseUrl}}"],
              "path": ["programs", "{{programId}}", "rules"]
            },
            "description": "U8 group: children born 2017–2020 (under 8 as of ~2025). 2 sessions/week, 20 places. Saves `ruleId`."
          }
        },
        {
          "name": "Add Rule — U10 (born 2015–2016)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"U10\",\n  \"ruleType\": \"BIRTH_YEAR_RANGE\",\n  \"minBirthYear\": 2015,\n  \"maxBirthYear\": 2016,\n  \"sessionsPerWeek\": 2,\n  \"capacity\": 18\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/programs/{{programId}}/rules",
              "host": ["{{baseUrl}}"],
              "path": ["programs", "{{programId}}", "rules"]
            }
          }
        },
        {
          "name": "Add Rule — Junior Squad (born 2012–2014)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"Junior Squad\",\n  \"ruleType\": \"BIRTH_YEAR_RANGE\",\n  \"minBirthYear\": 2012,\n  \"maxBirthYear\": 2014,\n  \"sessionsPerWeek\": 3,\n  \"capacity\": 16\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/programs/{{programId}}/rules",
              "host": ["{{baseUrl}}"],
              "path": ["programs", "{{programId}}", "rules"]
            },
            "description": "Junior Squad: 3x/week, 16 places. Range 2012–2014 does not overlap with U10 (2015–2016) or U8 (2017–2020)."
          }
        },
        {
          "name": "Add Rule — Overlapping range (expect 409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"Overlap Test\",\n  \"minBirthYear\": 2013,\n  \"maxBirthYear\": 2018,\n  \"sessionsPerWeek\": 2,\n  \"capacity\": 10\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/programs/{{programId}}/rules",
              "host": ["{{baseUrl}}"],
              "path": ["programs", "{{programId}}", "rules"]
            },
            "description": "**Expected: HTTP 409** — range 2013–2018 overlaps Junior Squad (2012–2014), U10 (2015–2016), and U8 (2017–2020). The error message names the first conflicting rule's label."
          }
        },
        {
          "name": "Remove Rule (Soft)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/programs/{{programId}}/rules/{{ruleId}}",
              "host": ["{{baseUrl}}"],
              "path": ["programs", "{{programId}}", "rules", "{{ruleId}}"]
            },
            "description": "Soft-deletes the rule. Returns 204. After deletion a new rule with the same birth year range can be added."
          }
        }
      ]
    },
    {
      "name": "7 — Error Cases (Reference)",
      "description": "Intentionally broken requests. Use these to confirm error handling works before sharing with frontend.",
      "item": [
        {
          "name": "Create Season — Missing endDate (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
