              "path": ["seasons", "{{seasonId}}", "terms", "{{term2Id}}"]
            },
            "description": "**Expected: HTTP 400** — Term 2 is DRAFT; cannot jump to CLOSED. Must go DRAFT→OPEN first."
          }
        },
        {
          "name": "Create Program — Duplicate code (409)",
          "request": {
