              "mode": "raw",
              "raw": "{\n  \"name\": \"Incomplete\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/seasons", "host": ["{{baseUrl}}"], "path": ["seasons"] },
            "description": "**Expected: HTTP 400** — `startDate` and `endDate` required."
          }
        },
        {
          "name": "Create Season — Duplicate name (409)",
