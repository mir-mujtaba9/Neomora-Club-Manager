          }
        },
        {
          "name": "Get non-existent season (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/seasons/00000000-0000-0000-0000-000000000000",
              "host": ["{{baseUrl}}"],
