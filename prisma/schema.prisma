generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                          String                    @id @default(uuid())
  name                        String
  slug                        String                    @unique
  schemaName                  String                    @unique @map("schema_name")
  plan                        TenantPlan                @default(STARTER)
  status                      TenantStatus              @default(ACTIVE)
  defaultLang                 String                    @default("en") @map("default_lang")
  balanceThreshold            Decimal?                  @default(0) @map("balance_threshold") @db.Decimal(10, 2)
  whatsappPhoneId             String?                   @map("whatsapp_phone_id")
  wabaId                      String?                   @map("waba_id")
  whatsappToken               String?                   @map("whatsapp_token")
  emailFrom                   String?                   @map("email_from")
  emailReplyTo                String?                   @map("email_reply_to")
  deletedAt                   DateTime?                 @map("deleted_at")
  createdAt                   DateTime                  @default(now()) @map("created_at")
  defaultPaymentGateway       PaymentGateway?           @map("default_payment_gateway")
  Subscription                Subscription[]
  apiKeys                     ApiKey[]
  attendanceRecords           AttendanceRecord[]
  auditLogs                   AuditLog[]
  broadcastMessages           BroadcastMessage[]
  cm_payment_reminder_configs CmPaymentReminderConfig[]
  cm_payment_webhook_events   CmPaymentWebhookEvent[]
  documents                   Document[]
  enrolments                  Enrolment[]
  guardians                   Guardian[]
  invoices                    Invoice[]
  locations                   Location[]
  notifications               Notification[]
  participants                Participant[]
  paymentPlans                PaymentPlan[]
  payments                    Payment[]
  refreshTokens               RefreshToken[]
  sessions                    Session[]
  staffNotes                  StaffNote[]
  users                       User[]
  waitlist                    Waitlist[]
  webhookEvents               WebhookEvent[]
  webhookSubscriptions        WebhookSubscription[]
  userLocations               UserLocation[]
  seasons                     Season[]
  programs                    Program[]
  programRules                ProgramRule[]
  rateCards                   RateCard[]
  discountRules               DiscountRule[]
  vatRates                    VatRate[]
  messageTemplates            MessageTemplate[]
  automationRules             AutomationRule[]

  @@map("tenants")
}

model Location {
  id                String             @id @default(uuid())
  tenantId          String             @map("tenant_id")
  name              String
  city              String
  address           String?
  phone             String?
  capacity          Int
  status            String             @default("active")
  registrationSlug  String?            @unique @map("registration_slug")
  qrCodeUrl         String?            @map("qr_code_url")
  defaultLang       String             @default("en") @map("default_lang")
  deletedAt         DateTime?          @map("deleted_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  attendanceRecords AttendanceRecord[]
  broadcastMessages BroadcastMessage[] @relation("FilterLocation")
  enrolments        Enrolment[]
  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  participants      Participant[]
  sessionLocations  SessionLocation[]
  users             User[]
  waitlist          Waitlist[]
  userLocations     UserLocation[]
  programs          Program[]

  @@index([tenantId, status])
  @@map("locations")
}

model User {
  id                  String               @id @default(uuid())
  tenantId            String               @map("tenant_id")
  locationId          String?              @map("location_id")
  email               String
  passwordHash        String               @map("password_hash")
  role                UserRole
  totpEnabled         Boolean              @default(false) @map("totp_enabled")
  totpSecret          String?              @map("totp_secret")
  failedAttempts      Int                  @default(0) @map("failed_attempts")
  locked              Boolean              @default(false)
  lockedUntil         DateTime?            @map("locked_until")
  lastLoginAt         DateTime?            @map("last_login_at")
  deletedAt           DateTime?            @map("deleted_at")
  createdAt           DateTime             @default(now()) @map("created_at")
  fullName            String?              @map("full_name")
  apiKeys             ApiKey[]
  markedAttendance    AttendanceRecord[]   @relation("MarkedBy")
  auditLogs           AuditLog[]
  broadcastMessages   BroadcastMessage[]
  verifiedDocs        Document[]           @relation("VerifiedBy")
  notifications       Notification[]       @relation("NotificationRecipientUser")
  passwordResetTokens PasswordResetToken[]
  recordedPayments    Payment[]            @relation("RecordedBy")
  verifiedPayments    Payment[]            @relation("VerifiedBy")
  refreshTokens       RefreshToken[]
  staffNotes          StaffNote[]
  isTempPassword      Boolean              @default(false) @map("is_temp_password")
  guardians           Guardian[]
  location            Location?            @relation(fields: [locationId], references: [id])
  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  userLocations       UserLocation[]

  @@unique([tenantId, email])
  @@index([tenantId, role])
  @@map("users")
}

model UserLocation {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  userId     String   @map("user_id")
  locationId String   @map("location_id")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([userId, locationId])
  @@index([tenantId, userId])
  @@index([tenantId, locationId])
  @@map("user_locations")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tenantId  String   @map("tenant_id")
  tokenHash String   @map("token_hash")
  jti       String   @unique
  revoked   Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([jti])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tenantId  String    @map("tenant_id")
  tokenHash String    @unique @map("token_hash")
  ipAddress String?   @map("ip_address")
  userAgent String?   @map("user_agent")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model ApiKey {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  createdById String    @map("created_by")
  keyHash     String    @unique @map("key_hash")
  label       String
  scopes      String[]
  rateLimit   Int       @default(1000) @map("rate_limit")
  lastUsedAt  DateTime? @map("last_used_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   User      @relation(fields: [createdById], references: [id])
  tenant      Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("api_keys")
}

model Session {
  id                String             @id @default(uuid())
  tenantId          String             @map("tenant_id")
  name              String
  startDate         DateTime           @map("start_date") @db.Date
  endDate           DateTime           @map("end_date") @db.Date
  baseFee           Decimal            @map("base_fee") @db.Decimal(10, 2)
  status            SessionStatus      @default(DRAFT)
  enrolOpenAt       DateTime?          @map("enrol_open_at")
  enrolCloseAt      DateTime?          @map("enrol_close_at")
  deletedAt         DateTime?          @map("deleted_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  seasonId          String?            @map("season_id")
  termNumber        Int?               @map("term_number")
  totalWeeks        Int?               @map("total_weeks")
  attendanceRecords AttendanceRecord[]
  broadcastMessages BroadcastMessage[] @relation("FilterSession")
  enrolments        Enrolment[]
  paymentPlans      PaymentPlan[]
  sessionLocations  SessionLocation[]
  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  season            Season?            @relation(fields: [seasonId], references: [id])
  waitlist          Waitlist[]

  @@index([tenantId, status])
  @@index([tenantId, seasonId])
  @@map("sessions")
}

model SessionLocation {
  id          String   @id @default(uuid())
  sessionId   String   @map("session_id")
  locationId  String   @map("location_id")
  feeOverride Decimal? @map("fee_override") @db.Decimal(10, 2)
  location    Location @relation(fields: [locationId], references: [id])
  session     Session  @relation(fields: [sessionId], references: [id])

  @@unique([sessionId, locationId])
  @@map("session_locations")
}

model PaymentPlan {
  id               String          @id @default(uuid())
  tenantId         String          @map("tenant_id")
  sessionId        String          @map("session_id")
  type             PaymentPlanType
  instalmentCount  Int             @map("instalment_count")
  instalmentAmount Decimal         @map("instalment_amount") @db.Decimal(10, 2)
  dueDates         DateTime[]      @map("due_dates")
  deletedAt        DateTime?       @map("deleted_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  session          Session         @relation(fields: [sessionId], references: [id])
  tenant           Tenant          @relation(fields: [tenantId], references: [id])

  @@index([tenantId, sessionId])
  @@map("payment_plans")
}

model Participant {
  id                 String                        @id @default(uuid())
  tenantId           String                        @map("tenant_id")
  locationId         String                        @map("location_id")
  uniqueId           String                        @map("unique_id")
  firstNameEn        String                        @map("first_name_en")
  firstNameAr        String?                       @map("first_name_ar")
  lastNameEn         String                        @map("last_name_en")
  lastNameAr         String?                       @map("last_name_ar")
  dateOfBirth        DateTime                      @map("date_of_birth") @db.Date
  gender             Gender
  nationality        String?
  status             ParticipantStatus             @default(INQUIRY)
  phone              String
  email              String?
  medicalNotes       String?                       @map("medical_notes")
  preferredLang      String                        @default("en") @map("preferred_lang")
  registrationSource ParticipantRegistrationSource @default(PUBLIC_FORM) @map("registration_source")
  deletedAt          DateTime?                     @map("deleted_at")
  createdAt          DateTime                      @default(now()) @map("created_at")
  attendanceRecords  AttendanceRecord[]
  documents          Document[]
  enrolments         Enrolment[]
  guardians          Guardian[]
  notifications      Notification[]
  location           Location                      @relation(fields: [locationId], references: [id])
  tenant             Tenant                        @relation(fields: [tenantId], references: [id])
  staffNotes         StaffNote[]
  waitlist           Waitlist[]

  @@unique([tenantId, uniqueId])
  @@index([tenantId, status])
  @@index([tenantId, locationId])
  @@map("participants")
}

model Guardian {
  id                   String      @id @default(uuid())
  tenantId             String      @map("tenant_id")
  participantId        String      @map("participant_id")
  fullName             String      @map("full_name")
  relationship         String
  phone                String
  email                String?
  portalToken          String?     @unique @map("portal_token")
  portalTokenExpiresAt DateTime?   @map("portal_token_expires_at")
  deletedAt            DateTime?   @map("deleted_at")
  createdAt            DateTime    @default(now()) @map("created_at")
  userId               String?     @map("user_id")
  participant          Participant @relation(fields: [participantId], references: [id])
  tenant               Tenant      @relation(fields: [tenantId], references: [id])
  user                 User?       @relation(fields: [userId], references: [id])

  @@index([tenantId, participantId])
  @@index([portalToken])
  @@map("guardians")
}

model Enrolment {
  id               String          @id @default(uuid())
  tenantId         String          @map("tenant_id")
  participantId    String          @map("participant_id")
  sessionId        String          @map("session_id")
  locationId       String          @map("location_id")
  reEnrolledFromId String?         @map("re_enrolled_from")
  status           EnrolmentStatus @default(FEE_PENDING)
  paymentPlanType  PaymentPlanType @map("payment_plan_type")
  totalFee         Decimal         @map("total_fee") @db.Decimal(10, 2)
  paidAmount       Decimal         @default(0) @map("paid_amount") @db.Decimal(10, 2)
  balance          Decimal         @map("balance") @db.Decimal(10, 2)
  waitlistPosition Int?            @map("waitlist_position")
  enrolledAt       DateTime?       @map("enrolled_at")
  deletedAt        DateTime?       @map("deleted_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  feeOverride      Decimal?        @map("fee_override") @db.Decimal(10, 2)
  programId        String?         @map("program_id")
  joinDate         DateTime?       @map("join_date") @db.Date
  commitmentLength Int?            @map("commitment_length")
  includeKit       Boolean?        @default(false) @map("include_kit")
  location         Location        @relation(fields: [locationId], references: [id])
  participant      Participant     @relation(fields: [participantId], references: [id])
  reEnrolledFrom   Enrolment?      @relation("ReEnrolment", fields: [reEnrolledFromId], references: [id])
  reEnrolments     Enrolment[]     @relation("ReEnrolment")
  session          Session         @relation(fields: [sessionId], references: [id])
  tenant           Tenant          @relation(fields: [tenantId], references: [id])
  program          Program?        @relation(fields: [programId], references: [id])
  invoices         Invoice[]
  notifications    Notification[]
  payments         Payment[]

  @@index([tenantId, status])
  @@index([tenantId, sessionId])
  @@index([tenantId, participantId])
  @@map("enrolments")
}

model Document {
  id            String         @id @default(uuid())
  tenantId      String         @map("tenant_id")
  participantId String         @map("participant_id")
  docType       DocumentType   @map("doc_type")
  storageKey    String         @map("storage_key")
  status        DocumentStatus @default(PENDING)
  verifiedById  String?        @map("verified_by")
  verifiedAt    DateTime?      @map("verified_at")
  deletedAt     DateTime?      @map("deleted_at")
  uploadedAt    DateTime       @default(now()) @map("uploaded_at")
  participant   Participant    @relation(fields: [participantId], references: [id])
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  verifiedBy    User?          @relation("VerifiedBy", fields: [verifiedById], references: [id])

  @@index([tenantId, participantId])
  @@map("documents")
}

model Invoice {
  id                   String          @id @default(uuid())
  tenantId             String          @map("tenant_id")
  enrolmentId          String          @map("enrolment_id")
  invoiceNumber        String          @unique @map("invoice_number")
  amount               Decimal         @db.Decimal(10, 2)
  dueDate              DateTime        @map("due_date") @db.Date
  status               InvoiceStatus   @default(PENDING)
  paymentPlanType      PaymentPlanType @map("payment_plan_type")
  paymentLink          String?         @map("payment_link")
  paymentLinkExpiresAt DateTime?       @map("payment_link_expires_at")
  reminderSentCount    Int             @default(0) @map("reminder_sent_count")
  deletedAt            DateTime?       @map("deleted_at")
  createdAt            DateTime        @default(now()) @map("created_at")
  instalmentNo         Int?            @map("instalment_no")
  instalmentTotal      Int?            @map("instalment_total")
  breakdown            Json?           @map("breakdown")
  enrolment            Enrolment       @relation(fields: [enrolmentId], references: [id])
  tenant               Tenant          @relation(fields: [tenantId], references: [id])
  payments             Payment[]

  @@unique([tenantId, enrolmentId, instalmentNo], map: "invoices_enrolment_instalment_active_key", where: raw("((deleted_at IS NULL) AND (instalment_no IS NOT NULL))"))
  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@index([enrolmentId])
  @@index([tenantId, dueDate, status], map: "invoices_due_date_status_idx", where: raw("(deleted_at IS NULL)"))
  @@map("invoices")
}

model Payment {
  id             String         @id @default(uuid())
  tenantId       String         @map("tenant_id")
  invoiceId      String?        @map("invoice_id")
  enrolmentId    String         @map("enrolment_id")
  recordedById   String?        @map("recorded_by")
  verifiedById   String?        @map("verified_by")
  gateway        PaymentGateway
  gatewayRef     String?        @unique @map("gateway_ref")
  method         PaymentMethod
  amount         Decimal        @db.Decimal(10, 2)
  status         PaymentStatus  @default(PENDING)
  proofKey       String?        @map("proof_key")
  idempotencyKey String         @unique @map("idempotency_key")
  verifiedAt     DateTime?      @map("verified_at")
  paidAt         DateTime?      @map("paid_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  receiptKey     String?        @map("receipt_key")
  failureReason  String?        @map("failure_reason")
  enrolment      Enrolment      @relation(fields: [enrolmentId], references: [id])
  invoice        Invoice?       @relation(fields: [invoiceId], references: [id])
  recordedBy     User?          @relation("RecordedBy", fields: [recordedById], references: [id])
  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  verifiedBy     User?          @relation("VerifiedBy", fields: [verifiedById], references: [id])

  @@index([tenantId, status])
  @@index([enrolmentId])
  @@map("payments")
}

model Waitlist {
  id                  String              @id @default(uuid())
  tenantId            String              @map("tenant_id")
  participantId       String              @map("participant_id")
  sessionId           String              @map("session_id")
  locationId          String              @map("location_id")
  position            Int
  offerSentAt         DateTime?           @map("offer_sent_at")
  offerExpiresAt      DateTime?           @map("offer_expires_at")
  offerStatus         WaitlistOfferStatus @default(PENDING) @map("offer_status")
  deletedAt           DateTime?           @map("deleted_at")
  createdAt           DateTime            @default(now()) @map("created_at")
  offerToken          String?             @unique(where: raw("(offer_token IS NOT NULL)")) @map("offer_token")
  offerTokenExpiresAt DateTime?           @map("offer_token_expires_at")
  offerAttempts       Int                 @default(0) @map("offer_attempts")
  location            Location            @relation(fields: [locationId], references: [id])
  participant         Participant         @relation(fields: [participantId], references: [id])
  session             Session             @relation(fields: [sessionId], references: [id])
  tenant              Tenant              @relation(fields: [tenantId], references: [id])

  @@unique([sessionId, locationId, position], map: "waitlist_session_location_position_active_key", where: raw("(deleted_at IS NULL)"))
  @@index([tenantId, sessionId, locationId])
  @@index([offerExpiresAt])
  @@index([tenantId, sessionId, locationId], map: "waitlist_outstanding_offer_idx", where: raw("((offer_status = 'PENDING'::\"WaitlistOfferStatus\") AND (offer_sent_at IS NOT NULL) AND (deleted_at IS NULL))"))
  @@index([offerExpiresAt], map: "waitlist_pending_offer_expiry_idx", where: raw("((offer_status = 'PENDING'::\"WaitlistOfferStatus\") AND (offer_sent_at IS NOT NULL) AND (deleted_at IS NULL))"))
  @@map("waitlist")
}

model BroadcastMessage {
  id               String              @id @default(uuid())
  tenantId         String              @map("tenant_id")
  createdById      String              @map("created_by")
  channel          NotificationChannel
  filterLocationId String?             @map("filter_location_id")
  filterSessionId  String?             @map("filter_session_id")
  filterStatus     String?             @map("filter_status")
  messageBody      String              @map("message_body")
  sentCount        Int                 @default(0) @map("sent_count")
  failedCount      Int                 @default(0) @map("failed_count")
  createdAt        DateTime            @default(now()) @map("created_at")
  createdBy        User                @relation(fields: [createdById], references: [id])
  filterLocation   Location?           @relation("FilterLocation", fields: [filterLocationId], references: [id])
  filterSession    Session?            @relation("FilterSession", fields: [filterSessionId], references: [id])
  tenant           Tenant              @relation(fields: [tenantId], references: [id])
  notifications    Notification[]

  @@index([tenantId])
  @@map("broadcast_messages")
}

model Notification {
  id              String              @id @default(uuid())
  tenantId        String              @map("tenant_id")
  participantId   String?             @map("participant_id")
  enrolmentId     String?             @map("enrolment_id")
  broadcastId     String?             @map("broadcast_id")
  channel         NotificationChannel
  type            NotificationType
  status          NotificationStatus  @default(QUEUED)
  externalId      String?             @map("external_id")
  retryCount      Int                 @default(0) @map("retry_count")
  sentAt          DateTime?           @map("sent_at")
  createdAt       DateTime            @default(now()) @map("created_at")
  recipientUserId String?             @map("recipient_user_id")
  recipientPhone  String?             @map("recipient_phone")
  recipientEmail  String?             @map("recipient_email")
  bodyText        String?             @map("body_text")
  dedupeKey       String?             @map("dedupe_key")
  failureReason   String?             @map("failure_reason")
  broadcast       BroadcastMessage?   @relation(fields: [broadcastId], references: [id])
  enrolment       Enrolment?          @relation(fields: [enrolmentId], references: [id])
  participant     Participant?        @relation(fields: [participantId], references: [id])
  recipientUser   User?               @relation("NotificationRecipientUser", fields: [recipientUserId], references: [id])
  tenant          Tenant              @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, dedupeKey], map: "notifications_tenant_dedupe_key", where: raw("(dedupe_key IS NOT NULL)"))
  @@index([tenantId, status])
  @@index([participantId])
  @@index([recipientUserId], where: raw("(recipient_user_id IS NOT NULL)"))
  @@map("notifications")
}

model WebhookSubscription {
  id         String         @id @default(uuid())
  tenantId   String         @map("tenant_id")
  url        String
  events     String[]
  secretHash String         @map("secret_hash")
  active     Boolean        @default(true)
  createdAt  DateTime       @default(now()) @map("created_at")
  events_log WebhookEvent[]
  tenant     Tenant         @relation(fields: [tenantId], references: [id])

  @@index([tenantId, active])
  @@map("webhook_subscriptions")
}

model WebhookEvent {
  id             String              @id @default(uuid())
  tenantId       String              @map("tenant_id")
  subscriptionId String              @map("subscription_id")
  eventType      String              @map("event_type")
  payload        Json
  status         WebhookEventStatus  @default(PENDING)
  attemptCount   Int                 @default(0) @map("attempt_count")
  lastError      String?             @map("last_error")
  nextRetryAt    DateTime?           @map("next_retry_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  subscription   WebhookSubscription @relation(fields: [subscriptionId], references: [id])
  tenant         Tenant              @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status])
  @@index([nextRetryAt])
  @@map("webhook_events")
}

model AuditLog {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  userId      String?  @map("user_id")
  action      String
  resource    String
  resourceId  String   @map("resource_id")
  beforeState Json?    @map("before_state")
  afterState  Json?    @map("after_state")
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")
  hashSelf    String?  @map("hash_self")
  hashPrev    String?  @map("hash_prev")
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  user        User?    @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, resource, resourceId])
  @@map("audit_logs")
}

model StaffNote {
  id            String      @id @default(uuid())
  tenantId      String      @map("tenant_id")
  participantId String      @map("participant_id")
  authorId      String      @map("author_id")
  note          String
  deletedAt     DateTime?   @map("deleted_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  author        User        @relation(fields: [authorId], references: [id])
  participant   Participant @relation(fields: [participantId], references: [id])
  tenant        Tenant      @relation(fields: [tenantId], references: [id])

  @@index([tenantId, participantId])
  @@map("staff_notes")
}

model AttendanceRecord {
  id            String      @id @default(uuid())
  tenantId      String      @map("tenant_id")
  participantId String      @map("participant_id")
  sessionId     String      @map("session_id")
  locationId    String      @map("location_id")
  markedById    String      @map("marked_by_id")
  date          DateTime    @map("date") @db.Date
  present       Boolean     @default(true)
  note          String?
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  location      Location    @relation(fields: [locationId], references: [id])
  markedBy      User        @relation("MarkedBy", fields: [markedById], references: [id])
  participant   Participant @relation(fields: [participantId], references: [id])
  session       Session     @relation(fields: [sessionId], references: [id])
  tenant        Tenant      @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, participantId, sessionId, date])
  @@index([tenantId, sessionId, locationId, date])
  @@map("attendance_records")
}

model CmTenantCounter {
  tenantId   String @map("tenant_id")
  counterKey String @map("counter_key")
  nextValue  Int    @default(0) @map("next_value")

  @@id([tenantId, counterKey])
  @@map("cm_tenant_counters")
}

model CmPaymentReminderConfig {
  id            String              @id @default(uuid())
  tenantId      String              @map("tenant_id")
  daysBeforeDue Int                 @map("days_before_due")
  channel       NotificationChannel
  enabled       Boolean             @default(true)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamp(6)
  tenants       Tenant              @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "cm_payment_reminder_configs_tenant_fk")

  @@unique([tenantId, daysBeforeDue, channel], map: "cm_payment_reminder_configs_unique")
  @@map("cm_payment_reminder_configs")
}

model CmPaymentWebhookEvent {
  id              String         @id @default(uuid())
  tenantId        String?        @map("tenant_id")
  gateway         PaymentGateway
  externalEventId String?        @map("external_event_id")
  payload         Json
  headers         Json?
  signature       String?
  signatureValid  Boolean?       @map("signature_valid")
  processed       Boolean        @default(false)
  processedAt     DateTime?      @map("processed_at") @db.Timestamp(6)
  failureReason   String?        @map("failure_reason")
  receivedAt      DateTime       @default(now()) @map("received_at") @db.Timestamp(6)
  tenants         Tenant?        @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "cm_payment_webhook_events_tenant_fk")

  @@unique([gateway, externalEventId], map: "cm_payment_webhook_events_external_unique", where: raw("(external_event_id IS NOT NULL)"))
  @@index([receivedAt], map: "cm_payment_webhook_events_unprocessed_idx", where: raw("(processed = false)"))
  @@map("cm_payment_webhook_events")
}

model Plan {
  id              String         @id
  name            String
  code            PlanType       @unique
  maxUsers        Int
  maxLocations    Int
  maxParticipants Int
  createdAt       DateTime       @default(now())
  updatedAt       DateTime
  Subscription    Subscription[]
}

model PlatformAdmin {
  id           String       @id
  email        String       @unique
  passwordHash String
  firstName    String
  lastName     String?
  role         PlatformRole
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime
}

model Subscription {
  id        String             @id
  tenantId  String
  planId    String
  status    SubscriptionStatus
  startDate DateTime
  endDate   DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime
  Plan      Plan               @relation(fields: [planId], references: [id])
  tenants   Tenant             @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

enum TenantPlan {
  STARTER
  GROWTH
  ENTERPRISE
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserRole {
  SUPER_ADMIN
  LOCATION_MANAGER
  FINANCE_OFFICER
  STAFF
  PARENT
}

enum ParticipantStatus {
