  OPEN
  ONGOING
  CLOSED
  ARCHIVED
}

enum EnrolmentStatus {
  WAITLISTED
  DOCUMENTS_PENDING
  FEE_PENDING
  ACTIVE
  ON_HOLD
  COMPLETED
  WITHDRAWN
}

enum DocumentType {
  BIRTH_CERTIFICATE
  PASSPORT
  MEDICAL_CLEARANCE
  ID_PHOTO
  OTHER
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum PaymentPlanType {
