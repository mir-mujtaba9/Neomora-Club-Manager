  FEMALE
}

model MessageTemplate {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  category  String
  language  String
  status    String   @default("PENDING")
  body      String
  metaId    String?  @map("meta_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rules  AutomationRule[]

  @@unique([tenantId, name, language])
  @@index([tenantId])
  @@map("message_templates")
}

model AutomationRule {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  trigger    String
  templateId String   @map("template_id")
  channel    String
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template MessageTemplate @relation(fields: [templateId], references: [id])

  @@unique([tenantId, trigger])
  @@index([tenantId])
  @@map("automation_rules")
}

enum NotificationChannel {
  WHATSAPP
  EMAIL
}

enum NotificationType {
  REGISTRATION_CONFIRM
  DOCUMENT_REQUEST
  FEE_INVOICE
  PAYMENT_CONFIRM
  PAYMENT_REMINDER
  SESSION_START
  WAITLIST_OFFER
  BROADCAST
  STAFF_ALERT
  GUARDIAN_MAGIC_LINK
  PASSWORD_RESET
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  DELIVERED
}

enum WebhookEventStatus {
  PENDING
  DELIVERED
  FAILED
  ABANDONED
}

enum PlanType {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum PlatformRole {
  OWNER
  SUPER_ADMIN
  SUPPORT
}

enum SubscriptionStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
  CANCELLED
}

// ─── Seasons & Terms ──────────────────────────────────────────────────────────

model Season {
  id        String       @id @default(uuid())
  tenantId  String       @map("tenant_id")
  name      String
  startDate DateTime     @map("start_date") @db.Date
  endDate   DateTime     @map("end_date") @db.Date
  status    SeasonStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  tenant    Tenant       @relation(fields: [tenantId], references: [id])
  sessions  Session[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@map("seasons")
}

// ─── Programs ────────────────────────────────────────────────────────────────

model Program {
  id         String        @id @default(uuid())
  tenantId   String        @map("tenant_id")
  code       String
  name       String
  locationId String?       @map("location_id")
  deletedAt  DateTime?     @map("deleted_at")
  createdAt  DateTime      @default(now()) @map("created_at")
  location   Location?     @relation(fields: [locationId], references: [id])
  tenant     Tenant        @relation(fields: [tenantId], references: [id])
  rules      ProgramRule[]
  enrolments Enrolment[]
  rateCards  RateCard[]
  discountRules DiscountRule[]

  @@unique([tenantId, code], map: "programs_tenant_code_active_key", where: raw("(deleted_at IS NULL)"))
  @@index([tenantId])
  @@map("programs")
}

model RateCard {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  programId        String    @map("program_id")
  weeklyRate       Decimal   @map("weekly_rate") @db.Decimal(10, 2)
  registrationFee  Decimal   @default(0) @map("registration_fee") @db.Decimal(10, 2)
  kitFee           Decimal   @default(0) @map("kit_fee") @db.Decimal(10, 2)
  minBillableWeeks Int       @default(1) @map("min_billable_weeks")
  effectiveFrom    DateTime  @map("effective_from")
  effectiveTo      DateTime? @map("effective_to")
  deletedAt        DateTime? @map("deleted_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  program Program @relation(fields: [programId], references: [id])
  tenant  Tenant  @relation(fields: [tenantId], references: [id])

  @@index([programId])
  @@index([tenantId])
  @@map("rate_cards")
}

model ProgramRule {
  id              String          @id @default(uuid())
  tenantId        String          @map("tenant_id")
  programId       String          @map("program_id")
  label           String
  ruleType        ProgramRuleType @default(BIRTH_YEAR_RANGE) @map("rule_type")
  minBirthYear    Int             @map("min_birth_year")
  maxBirthYear    Int             @map("max_birth_year")
  sessionsPerWeek Int             @map("sessions_per_week")
  capacity        Int
  deletedAt       DateTime?       @map("deleted_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  program         Program         @relation(fields: [programId], references: [id])
  tenant          Tenant          @relation(fields: [tenantId], references: [id])

  @@index([programId])
  @@index([tenantId])
  @@map("program_rules")
}

enum SeasonStatus {
  ACTIVE
  ARCHIVED
}

enum ProgramRuleType {
  BIRTH_YEAR_RANGE
  EXACT_BIRTH_YEAR
}

enum DiscountRuleType {
  SIBLING
  TERM_COMMITMENT
  PROMO_CODE
}

model DiscountRule {
  id         String           @id @default(uuid())
  tenantId   String           @map("tenant_id")
  ruleType   DiscountRuleType @map("rule_type")
  programId  String?          @map("program_id")
  percentage Decimal          @db.Decimal(5, 2)
  minWeeks   Int?             @map("min_weeks")
  isActive   Boolean          @default(true) @map("is_active")
  createdAt  DateTime         @default(now()) @map("created_at")

  program Program? @relation(fields: [programId], references: [id])
  tenant  Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([programId])
  @@map("discount_rules")
}

model VatRate {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  rate          Decimal  @db.Decimal(5, 2)
  effectiveFrom DateTime @map("effective_from") @db.Date
  createdAt     DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, effectiveFrom(sort: Desc)])
  @@map("vat_rates")
}

